# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# claude config (local only, except PROJECT.md and STACK.md)
.claude/*
!.claude/STACK.md
!.claude/PROJECT.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files (generated via "make build" / copy_env.sh)
.env
.env*.local
.env.production

# typescript
*.tsbuildinfo
next-env.d.ts

# crawler staging output (JSONL files, not committed)
/ops/crawl-output/

# book source files (copyrighted, local only — dirs kept via .gitkeep)
/ops/books/**/*
!/ops/books/**/.gitkeep

# graphify
/graphify-out/
