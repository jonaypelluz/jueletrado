{
  "cleanupPeriodDays": 30,
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(node *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(make *)",
      "Bash(docker *)",
      "Bash(perl *)",
      "Bash(sed *)",
      "Bash(sleep *)",
      "Bash(jq *)",
      "Bash(bash *)",
      "Bash(grep *)",
      "Bash(python3 *)",
      "Bash(read f *)",
      "Bash(chmod +x *)",
      "Bash(gzip *)",
      "Bash(tail *)",
      "Bash(awk *)",
      "Bash(echo *)",
      "Bash(curl *)",
      "Bash(sleep $((RANDOM % 21 + 10)) && echo \"done\")",
      "WebFetch(domain:localhost)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:www.wikidata.org)",
      "WebFetch(domain:es.wikipedia.org)",
      "WebFetch(domain:en.wikipedia.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-commit-branch-prefix.sh",
            "if": "Bash(git commit *)",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "juliusbrussee/caveman"
      }
    }
  }
}
