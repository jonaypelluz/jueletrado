{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75"
  },
  "cleanupPeriodDays": 30,
  "includeCoAuthoredBy": false,
  "disableBundledSkills": true,
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(nvm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(find *)",
      "Bash(gh *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(make *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(uv *)",
      "Bash(jq *)",
      "Bash(bash *)",
      "Bash(grep *)",
      "Bash(tail *)",
      "Bash(echo *)",
      "Bash(curl *)",
      "Bash(awk *)",
      "Bash(cat *)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:support.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:platform.claude.com)"
    ],
    "deny": [
      "Bash(npm *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(pkill *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-commit-branch-prefix.sh",
            "if": "Bash(git commit *)",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Trusting in the Force",
      "Following the Jedi way",
      "Listening to the will of the Force",
      "Meditating on Jedi wisdom",
      "Letting the Force guide each step",
      "Honoring the Jedi Code",
      "Feeling the living Force around me",
      "Walking the path of the Jedi"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "juliusbrussee/caveman"
      }
    }
  }
}
